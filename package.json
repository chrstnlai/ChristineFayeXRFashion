{
  "name": "head-tracked-webgl-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:sync": "node ./scripts/sync-mediapipe-assets.mjs",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
